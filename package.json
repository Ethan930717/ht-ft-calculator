{
  "name": "ht-ft-calculator",
  "version": "1.0.0",
  "description": "半全场实战配资计算器 (Dutching Synthetic Single Calculator)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve": "npx serve .",
    "dev": "npx serve .",
    "prepare:web": "node scripts/prepare-web.js",
    "tauri": "tauri",
    "build:tauri": "node scripts/prepare-web.js && tauri build",
    "dist:win": "electron-builder --win --x64 --ia32",
    "build:win": "electron-builder --win --x64 --ia32"
  },
  "build": {
    "appId": "com.dahu.htftcalc",
    "productName": "半全场实战配资计算器",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "files": [
      "index.html",
      "main.js",
      "css/**/*",
      "js/**/*",
      "img/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "keywords": [
    "sports-lottery",
    "jingcai",
    "dutched-betting",
    "calculator",
    "hafu",
    "football-analytics"
  ],
  "author": "大胡 (Dahu)",
  "license": "MIT"
}
